#!/bin/sh

echo
echo "============================================================"
echo "             TinyCore Tools - System Information"
echo "============================================================"
echo

# -----------------------------------------------------------------------------
# CPU
# -----------------------------------------------------------------------------

CPU="$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null \
    | cut -d: -f2- \
    | sed 's/^ *//')"

if [ -z "$CPU" ]; then
    CPU="$(grep -m1 'cpu' /proc/cpuinfo 2>/dev/null \
        | cut -d: -f2- \
        | sed 's/^ *//')"
fi

echo "CPU      : ${CPU:-Unknown}"

# -----------------------------------------------------------------------------
# Architecture
# -----------------------------------------------------------------------------

ARCH="$(uname -m)"
echo "Arch     : $ARCH"

# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------

MEM_KB="$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')"

if [ -n "$MEM_KB" ]; then
    MEM_MB=$((MEM_KB / 1024))
    echo "Memory   : ${MEM_MB} MB"
else
    echo "Memory   : Unknown"
fi

# -----------------------------------------------------------------------------
# Kernel
# -----------------------------------------------------------------------------

echo "Kernel   : $(uname -r)"

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

echo
echo "Network"
echo "------------------------------------------------------------"

INTERFACE=""

# First preference:
# Find the interface being used by the default route.
INTERFACE="$(route -n 2>/dev/null \
    | awk '$1 == "0.0.0.0" {print $8; exit}')"

# Second preference:
# Find the first non-loopback interface with an IPv4 address.
if [ -z "$INTERFACE" ]; then

    for IFACE_PATH in /sys/class/net/*; do

        NAME="$(basename "$IFACE_PATH")"

        [ "$NAME" = "lo" ] && continue
        [ "$NAME" = "dummy0" ] && continue

        IP="$(ifconfig "$NAME" 2>/dev/null \
            | sed -n 's/.*inet addr:\([^ ]*\).*/\1/p' \
            | head -n1)"

        if [ -n "$IP" ]; then
            INTERFACE="$NAME"
            break
        fi

    done

fi

# -----------------------------------------------------------------------------
# Display selected interface
# -----------------------------------------------------------------------------

if [ -n "$INTERFACE" ]; then

    echo "Interface: $INTERFACE"

    # MAC address
    if [ -f "/sys/class/net/$INTERFACE/address" ]; then
        MAC="$(cat "/sys/class/net/$INTERFACE/address")"
        echo "MAC      : $MAC"
    else
        echo "MAC      : Unknown"
    fi

    # IPv4 address
    IP="$(ifconfig "$INTERFACE" 2>/dev/null \
        | sed -n 's/.*inet addr:\([^ ]*\).*/\1/p' \
        | head -n1)"

    if [ -n "$IP" ]; then
        echo "IP       : $IP"
    else
        echo "IP       : Not configured"
    fi

    # Default gateway
    GATEWAY="$(route -n 2>/dev/null \
        | awk -v iface="$INTERFACE" \
          '$1 == "0.0.0.0" && $8 == iface {print $2; exit}')"

    if [ -n "$GATEWAY" ]; then
        echo "Gateway  : $GATEWAY"
    else
        echo "Gateway  : None"
    fi

else

    echo "No active network interface detected."

fi

echo
echo "============================================================"
echo