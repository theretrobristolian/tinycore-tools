#!/bin/sh

LINE="============================================================"
SUB="------------------------------------------------------------"

page_output() {
    if command -v less >/dev/null 2>&1; then
        less
    elif command -v more >/dev/null 2>&1; then
        more
    else
        cat
    fi
}

show_group() {
    TITLE="$1"
    PATTERN="$2"

    RESULTS="$(lspci -nn | grep -Ei "$PATTERN" || true)"

    echo "$TITLE"
    echo "$SUB"

    if [ -n "$RESULTS" ]; then
        echo "$RESULTS"
    else
        echo "None detected."
    fi

    echo
}

show_header() {
    echo
    echo "$LINE"
    echo "              TinyCore Tools - PCI Information"
    echo "$LINE"
    echo
}

show_footer() {
    echo "$SUB"
    echo "PCI IDs are shown as [vendor:device], e.g. [8086:100e]."
    echo "More: pciinfo network|storage|display|usb|audio|all"
    echo "$LINE"
    echo
}

show_header

if ! command -v lspci >/dev/null 2>&1; then
    echo "lspci is unavailable - showing raw Linux PCI IDs."
    echo "$SUB"

    for DEVICE_PATH in /sys/bus/pci/devices/*; do
        [ -d "$DEVICE_PATH" ] || continue
        SLOT="$(basename "$DEVICE_PATH")"
        VENDOR="$(cat "$DEVICE_PATH/vendor" 2>/dev/null)"
        DEVICE_ID="$(cat "$DEVICE_PATH/device" 2>/dev/null)"
        CLASS="$(cat "$DEVICE_PATH/class" 2>/dev/null)"
        echo "$SLOT  ${VENDOR#0x}:${DEVICE_ID#0x}  Class:${CLASS#0x}"
    done

    echo
    echo "$LINE"
    exit 0
fi

case "${1:-}" in
    network|net)
        show_group "Network" 'ethernet|network|wireless'
        show_footer
        exit 0
        ;;
    storage|disk)
        show_group "Storage" 'sata|ide|raid|scsi|non-volatile|nvme|mass storage'
        show_footer
        exit 0
        ;;
    display|video|gpu)
        show_group "Display" 'vga|display|3d controller'
        show_footer
        exit 0
        ;;
    usb)
        show_group "USB" 'usb controller'
        show_footer
        exit 0
        ;;
    audio|sound)
        show_group "Audio" 'audio|multimedia audio'
        show_footer
        exit 0
        ;;
    all)
        {
            echo "$LINE"
            echo "          TinyCore Tools - Complete PCI Device List"
            echo "$LINE"
            echo
            lspci -nn
            echo
            echo "$LINE"
        } | page_output
        exit 0
        ;;
    "")
        # Default view is intentionally tiny. For the main project use case,
        # the network controller ID is the most useful information, followed
        # by storage hardware when working with local disks.
        show_group "Network" 'ethernet|network|wireless'
        show_group "Storage" 'sata|ide|raid|scsi|non-volatile|nvme|mass storage'
        show_footer
        exit 0
        ;;
    *)
        echo "Unknown category: $1"
        echo
        echo "Usage: pciinfo [network|storage|display|usb|audio|all]"
        echo "$LINE"
        exit 1
        ;;
esac
