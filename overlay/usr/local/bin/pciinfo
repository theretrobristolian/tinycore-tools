#!/bin/sh

LINE="============================================================"
SUB="------------------------------------------------------------"

section() {
    TITLE="$1"
    PATTERN="$2"

    RESULTS="$(lspci -nn | grep -Ei "$PATTERN" || true)"

    if [ -n "$RESULTS" ]; then
        echo "$TITLE"
        echo "$SUB"
        echo "$RESULTS"
        echo
    fi
}

echo
echo "$LINE"
echo "              TinyCore Tools - PCI Information"
echo "$LINE"
echo

if ! command -v lspci >/dev/null 2>&1; then
    echo "lspci is unavailable - showing raw Linux PCI IDs."
    echo "$SUB"

    FOUND=0
    for DEVICE_PATH in /sys/bus/pci/devices/*; do
        [ -d "$DEVICE_PATH" ] || continue
        FOUND=1

        SLOT="$(basename "$DEVICE_PATH")"
        VENDOR="$(cat "$DEVICE_PATH/vendor" 2>/dev/null)"
        DEVICE_ID="$(cat "$DEVICE_PATH/device" 2>/dev/null)"
        CLASS="$(cat "$DEVICE_PATH/class" 2>/dev/null)"

        echo "$SLOT  ${VENDOR#0x}:${DEVICE_ID#0x}  Class:${CLASS#0x}"
    done

    [ "$FOUND" -eq 1 ] || echo "No PCI devices detected."
    echo
    echo "$LINE"
    exit 0
fi

if [ "${1:-}" = "all" ]; then
    echo "All PCI Devices"
    echo "$SUB"
    lspci -nn
    echo
    echo "$LINE"
    exit 0
fi

section "Network" 'ethernet|network|wireless'
section "Storage" 'sata|ide|raid|scsi|non-volatile|nvme|mass storage'
section "Display" 'vga|display|3d controller'
section "USB" 'usb controller'
section "Audio" 'audio|multimedia audio'
section "Bridges / Chipset" 'host bridge|isa bridge|pci bridge|smbus'

OTHER="$(lspci -nn | grep -Eiv 'ethernet|network|wireless|sata|ide|raid|scsi|non-volatile|nvme|mass storage|vga|display|3d controller|usb controller|audio|multimedia audio|host bridge|isa bridge|pci bridge|smbus' || true)"

if [ -n "$OTHER" ]; then
    echo "Other"
    echo "$SUB"
    echo "$OTHER"
    echo
fi

echo "PCI IDs are shown as [vendor:device], e.g. [8086:100e]."
echo "Run 'pciinfo all' for the complete raw PCI device list."
echo
echo "$LINE"
echo