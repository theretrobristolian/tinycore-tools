#!/bin/sh

LINE="============================================================"
SUB="------------------------------------------------------------"

show_group() {
    TITLE="$1"
    PATTERN="$2"
    RESULTS="$(lspci -nn | grep -Ei "$PATTERN" || true)"

    if [ -n "$RESULTS" ]; then
        echo "$TITLE"
        echo "$SUB"
        echo "$RESULTS"
        echo
    fi
}

page_output() {
    if command -v less >/dev/null 2>&1; then
        less
    elif command -v more >/dev/null 2>&1; then
        more
    else
        cat
    fi
}

echo
echo "$LINE"
echo "              TinyCore Tools - PCI Information"
echo "$LINE"
echo

if ! command -v lspci >/dev/null 2>&1; then
    echo "lspci is unavailable - showing raw Linux PCI IDs."
    echo "$SUB"

    for DEVICE_PATH in /sys/bus/pci/devices/*; do
        [ -d "$DEVICE_PATH" ] || continue
        SLOT="$(basename "$DEVICE_PATH")"
        VENDOR="$(cat "$DEVICE_PATH/vendor" 2>/dev/null)"
        DEVICE_ID="$(cat "$DEVICE_PATH/device" 2>/dev/null)"
        CLASS="$(cat "$DEVICE_PATH/class" 2>/dev/null)"
        echo "$SLOT  ${VENDOR#0x}:${DEVICE_ID#0x}  Class:${CLASS#0x}"
    done

    echo
echo "$LINE"
    exit 0
fi

case "${1:-}" in
    all)
        {
            echo "$LINE"
            echo "          TinyCore Tools - Complete PCI Device List"
            echo "$LINE"
            echo
            lspci -nn
            echo
            echo "$LINE"
        } | page_output
        exit 0
        ;;
    network|net)
        show_group "Network" 'ethernet|network|wireless'
        echo "$LINE"
        exit 0
        ;;
    storage|disk)
        show_group "Storage" 'sata|ide|raid|scsi|non-volatile|nvme|mass storage'
        echo "$LINE"
        exit 0
        ;;
esac

# Default report deliberately concentrates on devices useful during hardware
# identification and iPXE/network troubleshooting. Bridges and chipset plumbing
# are omitted because they tend to swamp the useful information.
show_group "Network" 'ethernet|network|wireless'
show_group "Storage" 'sata|ide|raid|scsi|non-volatile|nvme|mass storage'
show_group "Display" 'vga|display|3d controller'
show_group "USB" 'usb controller'
show_group "Audio" 'audio|multimedia audio'

OTHER="$(lspci -nn | grep -Ei 'unclassified|communication controller|serial controller|firewire|card reader|sd host|encryption controller' || true)"
if [ -n "$OTHER" ]; then
    echo "Other useful devices"
    echo "$SUB"
    echo "$OTHER"
    echo
fi

echo "$SUB"
echo "PCI IDs are shown as [vendor:device], e.g. [8086:100e]."
echo "More: pciinfo network | pciinfo storage | pciinfo all"
echo "$LINE"
echo